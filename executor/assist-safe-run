#!/usr/bin/env bash
# Wrapper seguro do AGENT. Instalado em /usr/local/bin/assist-safe-run (root:root 0755)
# e liberado no sudoers SOMENTE ele. Ações fixas, argumentos validados, sem eval/shell livre.
set -euo pipefail
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
export DEBIAN_FRONTEND=noninteractive SYSTEMD_PAGER=cat PAGER=cat SYSTEMD_COLORS=0

ALLOWED_SERVICES_FILE=/etc/assist/allowed-services   # só o root edita

log()  { logger -t assist-safe-run "user=${SUDO_USER:-${USER:-?}} $*" 2>/dev/null || true; }
deny() { echo "Comando não permitido: $*" >&2; log "NEGADO $*"; exit 2; }
svc_ok() {
  [[ "$1" =~ ^[A-Za-z0-9_.@-]{1,64}$ ]] && [[ -r "$ALLOWED_SERVICES_FILE" ]] \
    && grep -qxF -- "$1" "$ALLOWED_SERVICES_FILE"
}
num_ok() { [[ "$1" =~ ^[0-9]{1,5}$ ]]; }

[[ $# -ge 1 ]] || deny "(vazio)"
ACTION="$1"; shift
log "OK? $ACTION $*"

case "$ACTION" in
  status)
    [[ $# -eq 1 ]] && svc_ok "$1" || deny "$ACTION $*"
    exec systemctl status --no-pager -- "$1" ;;
  restart|start|stop)
    [[ $# -eq 1 ]] && svc_ok "$1" || deny "$ACTION $*"
    exec systemctl "$ACTION" -- "$1" ;;
  logs)
    [[ $# -ge 1 && $# -le 2 ]] && svc_ok "$1" || deny "$ACTION $*"
    n="${2:-100}"; [[ "$n" =~ ^[0-9]{1,3}$ ]] || deny "$ACTION $*"
    exec journalctl -u "$1" -n "$n" --no-pager ;;
  disk)
    [[ $# -eq 0 ]] || deny "$ACTION $*"
    exec df -h ;;
  apt-update)
    [[ $# -eq 0 ]] || deny "$ACTION $*"
    exec apt-get update -qq ;;
  ufw-allow|ufw-deny)
    [[ $# -eq 2 ]] && num_ok "$1" && [[ "$2" =~ ^(tcp|udp)$ ]] || deny "$ACTION $*"
    (( 10#$1 >= 1 && 10#$1 <= 65535 )) || deny "$ACTION $*"
    exec ufw "${ACTION#ufw-}" "$((10#$1))/$2" ;;
  ufw-reload)
    [[ $# -eq 0 ]] || deny "$ACTION $*"
    exec ufw reload ;;
  *)
    deny "$ACTION $*" ;;
esac
